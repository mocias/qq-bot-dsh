{
  "name": "dsh-onebot-voice-bridge",
  "version": "0.10.0-unified.1",
  "private": true,
  "type": "module",
  "description": "QQ 统一桥接：私聊语音、独立群聊与统一设置；保留工作区、记忆和权限隔离。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/unified-client.js",
    "./settings": "./lib/unified-settings.mjs",
    "./group": "./lib/group/index.mjs",
    "./voice": "./lib/voice/index.mjs",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "build-manifest.json", "README.md"],
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}, "client": {"platform": "web"}},
  "engines": {"node": ">=22", "dsh": "0.2.1-rc.2"},
  "dependencies": {"@napi-rs/canvas": "^1.0.6", "fontkit": "^2.0.4", "schemastery": "^3.18.0", "ws": "^8.18.0"},
  "scripts": {"test": "node --test test/*.test.mjs", "build": "node build.mjs"}
}
